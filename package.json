{
  "name": "forgeflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/free-dev-ports.mjs && node scripts/run-dev.mjs",
    "dev:server": "node scripts/free-dev-ports.mjs --server && pnpm --filter @forgeflow/server dev",
    "dev:web": "node scripts/free-dev-ports.mjs --web && pnpm --filter @forgeflow/web dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "start:server": "pnpm --filter @forgeflow/server start",
    "db:generate": "node scripts/generate-migration.mjs",
    "db:migrate": "pnpm --filter @forgeflow/server db:migrate",
    "seed:demo": "pnpm --filter @forgeflow/server seed:demo",
    "test": "pnpm --filter @forgeflow/server test"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
